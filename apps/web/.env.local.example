# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# Hosted services remain fail-closed unless the corresponding server-only gate
# is exactly "true". Enabling a gate is configuration evidence only; it does
# not prove provider activation or customer acceptance.
PHANTOM_BILLING_ENABLED=false
PHANTOM_CLOUD_VAULTS_ENABLED=false
PHANTOM_TEAMS_ENABLED=false

# Optional, browser-visible analytics configuration
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Vercel supplies VERCEL_GIT_COMMIT_SHA, VERCEL_DEPLOYMENT_ID, and VERCEL_ENV.
# Production readiness fails closed when that immutable build identity is
# absent or malformed; do not place credentials in build-identity variables.
