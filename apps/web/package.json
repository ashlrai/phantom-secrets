{
  "name": "phantom-web",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node --experimental-strip-types --test tests/*.test.cjs src/app/device/*.test.mjs src/app/device/*.test.ts",
    "test:billing-auth": "node --test tests/billing-auth.test.cjs",
    "test:claims": "node --test tests/public-claims.test.cjs",
    "test:responsive": "next build && node --test tests/quick-start-responsive.browser.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2",
    "next": "15.5.28",
    "posthog-js": "^1.364.2",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5.6.0",
    "stripe": "22.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.1",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
