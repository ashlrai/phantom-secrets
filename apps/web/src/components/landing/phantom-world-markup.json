"<section id=\"phantom-world\" class=\"phantom-world\" aria-labelledby=\"pw-title\" data-stage=\"0\">\n  <div class=\"pw-heading\">\n    <div>\n      <h2 id=\"pw-title\">Your resources.<br>One extraordinary team.</h2>\n      <p>Bring your subscriptions, API credits and local models into one engineering workbench. Give your agents the tools to turn an idea into a result.</p>\n    </div>\n    <span class=\"pw-demo-label\">Interactive demo \u00b7 no agents are running</span>\n  </div>\n  <div class=\"pw-mode\" role=\"group\" aria-label=\"Choose the demonstrated way of working\">\n    <button type=\"button\" data-mode=\"with\" aria-pressed=\"false\" disabled>Work with me</button>\n    <button type=\"button\" data-mode=\"for\" aria-pressed=\"true\" disabled>Work for me</button>\n  </div>\n  <p class=\"pw-disclaimer\" data-mode-description>The illustrative team moves through the task and brings you the result.</p>\n  <div class=\"pw-resource-console\">\n    <div class=\"pw-resource-tabs\" role=\"group\" aria-label=\"Explore resource types\">\n      <button type=\"button\" data-resource=\"subscription\" aria-pressed=\"true\" disabled>Subscriptions</button>\n      <button type=\"button\" data-resource=\"api\" aria-pressed=\"false\" disabled>API credits</button>\n      <button type=\"button\" data-resource=\"local\" aria-pressed=\"false\" disabled>Local models</button>\n      <button type=\"button\" data-resource=\"tools\" aria-pressed=\"false\" disabled>MCP &amp; CLI tools</button>\n    </div>\n    <div class=\"pw-provider-grid\" aria-label=\"Provider and tool identities\">\n      <div class=\"pw-provider\" data-provider-kind=\"subscription api\"><img src=\"/phantom-world/provider-claude.svg\" width=\"25\" height=\"25\" alt=\"\" loading=\"lazy\"><span>Anthropic<small>Claude Code</small></span></div>\n      <div class=\"pw-provider\" data-provider-kind=\"subscription api\"><img src=\"/phantom-world/provider-codex.svg\" width=\"25\" height=\"25\" alt=\"\" loading=\"lazy\"><span>OpenAI<small>Codex</small></span></div>\n      <div class=\"pw-provider\" data-provider-kind=\"subscription api\"><img src=\"/phantom-world/provider-grok.svg\" width=\"25\" height=\"25\" alt=\"\" loading=\"lazy\"><span>xAI<small>Grok</small></span></div>\n      <div class=\"pw-provider\" data-provider-kind=\"api\"><img src=\"/phantom-world/devin-mark.svg\" width=\"25\" height=\"25\" alt=\"\" loading=\"lazy\"><span>Devin<small>Cloud &amp; CLI</small></span></div>\n      <div class=\"pw-provider\" data-provider-kind=\"local\"><img src=\"/phantom-world/provider-local.svg\" width=\"25\" height=\"25\" alt=\"\" loading=\"lazy\"><span>On your machine<small>Local models</small></span></div>\n      <div class=\"pw-provider\" data-provider-kind=\"tools\"><img src=\"/phantom-world/provider-vercel.svg\" width=\"25\" height=\"25\" alt=\"\" loading=\"lazy\"><span>Vercel<small>Deployment tools</small></span></div>\n      <div class=\"pw-provider\" data-provider-kind=\"tools\"><img src=\"/phantom-world/provider-supabase.svg\" width=\"25\" height=\"25\" alt=\"\" loading=\"lazy\"><span>Supabase<small>Database tools</small></span></div>\n    </div>\n    <p class=\"pw-resource-description\" data-resource-description>Connect your supported CLI accounts. Each account keeps its own subscription window and usage reading.</p>\n  </div>\n  <div class=\"pw-layout\">\n    <div class=\"pw-scene\" role=\"group\" aria-label=\"Illustrated demo team: select an agent to inspect its task\">\n      <svg class=\"pw-ground\" viewBox=\"0 0 600 445\" aria-hidden=\"true\" focusable=\"false\">\n        <defs>\n          <pattern id=\"pw-grid\" width=\"28\" height=\"28\" patternUnits=\"userSpaceOnUse\"><circle cx=\"1\" cy=\"1\" r=\"1\" fill=\"#bad0e8\" opacity=\".6\"/></pattern>\n        </defs>\n        <path d=\"M42 239 301 105 564 240 301 378Z\" fill=\"url(#pw-grid)\"/>\n        <path class=\"pw-bridge\" d=\"M190 204 300 257 404 190 M300 257 300 312\"/>\n        <path class=\"pw-path\" d=\"M190 204 300 257 404 190 M300 257 300 312\"/>\n        <path class=\"pw-current pw-current-blue\" d=\"M190 204 300 257 404 190\"/>\n        <path class=\"pw-current pw-current-mint\" d=\"M404 190 300 257 300 312\"/>\n        <path class=\"pw-current pw-current-violet\" d=\"M300 312 300 257 190 204\"/>\n        <circle class=\"pw-node\" cx=\"300\" cy=\"257\" r=\"7\"/>\n        <g>\n          <path class=\"pw-tile-side\" d=\"M69 208 144 250 227 208V222L144 263 69 222Z\"/>\n          <path class=\"pw-tile-top\" d=\"M69 208 147 166 227 208 144 250Z\"/>\n          <path class=\"pw-tile-inset\" d=\"M97 208 147 181 198 208 147 234Z\"/>\n          <path d=\"M124 185 148 172 168 182 144 196Z\" fill=\"#bacee6\"/>\n          <path d=\"M124 185V197L144 208V196Z\" fill=\"#a8bfdc\"/>\n        </g>\n        <g>\n          <path class=\"pw-tile-side\" d=\"M360 193 438 235 519 193V207L438 248 360 207Z\"/>\n          <path class=\"pw-tile-top\" d=\"M360 193 440 151 519 193 438 235Z\"/>\n          <path class=\"pw-tile-inset\" d=\"M387 193 440 166 491 193 440 220Z\"/>\n          <path d=\"M416 170 441 157 462 168 437 181Z\" fill=\"#bacee6\"/>\n          <path d=\"M416 170V182L437 193V181Z\" fill=\"#a8bfdc\"/>\n        </g>\n        <g>\n          <path class=\"pw-tile-side\" d=\"M223 337 301 379 382 337V351L301 392 223 351Z\"/>\n          <path class=\"pw-tile-top\" d=\"M223 337 303 295 382 337 301 379Z\"/>\n          <path class=\"pw-tile-inset\" d=\"M250 337 303 310 354 337 303 364Z\"/>\n          <path d=\"M279 314 304 301 325 312 300 325Z\" fill=\"#bacee6\"/>\n          <path d=\"M279 314V326L300 337V325Z\" fill=\"#a8bfdc\"/>\n        </g>\n      </svg>\n      <button type=\"button\" class=\"pw-agent\" data-agent=\"scout\" aria-label=\"Inspect Scout: investigate the retry failure\" aria-pressed=\"true\" disabled>\n        <span class=\"pw-avatar\"><img src=\"/phantom-world/phantom-mark.svg\" alt=\"\" width=\"72\" height=\"72\" loading=\"lazy\" decoding=\"async\"></span>\n        <strong>Scout</strong><small>Find the cause</small>\n      </button>\n      <button type=\"button\" class=\"pw-agent\" data-agent=\"builder\" aria-label=\"Inspect Builder: prepare a focused patch\" aria-pressed=\"false\" disabled>\n        <span class=\"pw-avatar\"><img src=\"/phantom-world/phantom-mark.svg\" alt=\"\" width=\"72\" height=\"72\" loading=\"lazy\" decoding=\"async\"></span>\n        <strong>Builder</strong><small>Make the change</small>\n      </button>\n      <button type=\"button\" class=\"pw-agent\" data-agent=\"reviewer\" aria-label=\"Inspect Reviewer: verify and review the change\" aria-pressed=\"false\" disabled>\n        <span class=\"pw-avatar\"><img src=\"/phantom-world/phantom-mark.svg\" alt=\"\" width=\"72\" height=\"72\" loading=\"lazy\" decoding=\"async\"></span>\n        <strong>Reviewer</strong><small>Check the result</small>\n      </button>\n      <span class=\"pw-task-token\" aria-hidden=\"true\" data-token>Retry fix</span>\n      <span class=\"pw-island-label\">Illustrated handoffs \u00b7 one shared task</span>\n      <span class=\"pw-orbit pw-orbit-one\" aria-hidden=\"true\"></span><span class=\"pw-orbit pw-orbit-two\" aria-hidden=\"true\"></span>\n    </div>\n    <div class=\"pw-inspector\" aria-label=\"Demo task inspector\">\n      <p class=\"pw-inspector-label\" data-workflow-label>Delegated workflow \u00b7 a retry fix</p>\n      <h3 data-stage-title>Find the cause before changing the code</h3>\n      <p class=\"pw-inspector-description\" data-stage-description>Scout follows a reported retry failure to a small, reproducible case. The task and its context stay visible while the rest of the team gets ready.</p>\n      <dl class=\"pw-facts\">\n        <dt>Selected agent</dt><dd data-role-name>Scout</dd>\n        <dt>Task</dt><dd data-role-task>Investigate the retry failure</dd>\n        <dt>Context</dt><dd data-role-context>Report and reproduction</dd>\n      </dl>\n      <div class=\"pw-evidence\"><strong>What you would inspect</strong><span data-evidence>A reproducible case and a short explanation of the suspected cause.</span></div>\n    </div>\n  </div>\n  <ol class=\"pw-stage-list\" aria-label=\"Inspect the demo stages\">\n    <li><button type=\"button\" data-step=\"0\" aria-current=\"step\" disabled><span class=\"pw-stage-number\" aria-hidden=\"true\">1</span>Investigate</button></li>\n    <li><button type=\"button\" data-step=\"1\" disabled><span class=\"pw-stage-number\" aria-hidden=\"true\">2</span>Build</button></li>\n    <li><button type=\"button\" data-step=\"2\" disabled><span class=\"pw-stage-number\" aria-hidden=\"true\">3</span>Verify</button></li>\n    <li><button type=\"button\" data-step=\"3\" disabled><span class=\"pw-stage-number\" aria-hidden=\"true\">4</span>Review</button></li>\n    <li><button type=\"button\" data-step=\"4\" disabled><span class=\"pw-stage-number\" aria-hidden=\"true\">5</span>Result</button></li>\n  </ol>\n  <div class=\"pw-controls\" role=\"group\" aria-label=\"Control illustrative replay\">\n    <button type=\"button\" data-action=\"play\" aria-pressed=\"false\" disabled>Play demo</button>\n    <button type=\"button\" data-action=\"next\" disabled>Next stage</button>\n    <button type=\"button\" data-action=\"restart\" disabled>Reset demo</button>\n    <p class=\"pw-playback-status\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\" data-playback-status>1 of 5 \u00b7 Investigate \u00b7 Ready</p>\n  </div>\n  <div class=\"pw-toolkit\" aria-label=\"Open-source engineering toolkit\">\n    <div><span class=\"pw-toolkit-label\">The open-source toolkit</span><p>Tools with a job. One place to bring them together.</p></div>\n    <a href=\"/secrets\"><img src=\"/phantom-world/phantom-mark.svg\" width=\"24\" height=\"24\" alt=\"\">Phantom Secrets<span>Keep secrets out of model context</span></a>\n    <a href=\"https://github.com/ashlrai/locus\"><span class=\"pw-tool-icon\" aria-hidden=\"true\">\u25ce</span>Locus<span>Bind tools to the right account</span></a>\n    <a href=\"https://github.com/ashlrai/lexicon\"><span class=\"pw-tool-icon\" aria-hidden=\"true\">\u2248</span>Lexicon<span>Make technical voice input clearer</span></a>\n    <a href=\"https://verse.ashlr.ai/ecosystem\">Explore the ecosystem<span>Independent projects. Shared purpose.</span></a>\n  </div>\n  <p class=\"pw-disclaimer\">Provider logos identify resources. MCP servers and ecosystem tools need configuration.</p>\n  <noscript><p class=\"pw-disclaimer\">The static scene shows the first stage. Enable JavaScript to explore the illustrative replay.</p></noscript>\n</section>"
